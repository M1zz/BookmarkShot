    "스크랩한 문장을 매일 한 문장씩 만나요. 즐겨찾기한 문장이 있으면 그중에서 보여드려요." : {
      "comment" : "w_desc",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크랩한 문장을 매일 한 문장씩 만나요. 즐겨찾기한 문장이 있으면 그중에서 보여드려요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See one of your saved quotes each day. If you have favorites, it picks from those."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See one of your saved quotes each day. If you have favorites, it picks from those."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天重温一句你摘录的句子。如果有收藏的句子，会优先从中挑选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天重溫一句你摘錄的句子。若有加入我的最愛的句子，會優先從中挑選。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した文を毎日ひとつずつ表示します。お気に入りがあれば、その中から選びます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый день — одна из ваших сохранённых цитат. Если есть избранные, она выбирается среди них."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una de tus citas guardadas cada día. Si tienes favoritas, se elige entre ellas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Tag eines deiner gesicherten Zitate. Gibt es Favoriten, wird daraus ausgewählt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour, l’une de vos citations gardées. S’il y a des favoris, elle est choisie parmi eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni giorno una delle tue citazioni salvate. Se hai delle preferite, viene scelta tra quelle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo dia, um dos trechos que você salvou. Se houver favoritos, ele é escolhido entre eles."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พบกับประโยคที่คุณเก็บไว้วันละหนึ่งประโยค ถ้ามีรายการโปรด จะสุ่มจากในนั้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi ngày gặp lại một câu bạn đã lưu. Nếu có câu yêu thích, widget sẽ chọn trong số đó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý den jeden z vašich uložených citátů. Pokud máte oblíbené, vybírá se z nich."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
