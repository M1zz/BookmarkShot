    "NSCameraUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "책 표지와 페이지를 촬영해 문장을 추출하기 위해 카메라를 사용합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to photograph book covers and pages so the text can be picked out."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to photograph book covers and pages so the text can be picked out."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用相机拍摄书籍封面和书页，以便提取其中的句子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用相機拍攝書籍封面與書頁，以便擷取其中的句子。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本の表紙やページを撮影して文を抽出するために、カメラを使用します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера нужна, чтобы фотографировать обложки и страницы книг и извлекать из них текст."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara se usa para fotografiar portadas y páginas de libros y extraer sus frases."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird genutzt, um Buchcover und Seiten zu fotografieren und Sätze daraus zu übernehmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo sert à photographier les couvertures et les pages de livres pour en extraire les phrases."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 찍어둔 책 사진에서 문장을 추출하기 위해 사진 보관함에 접근합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos are accessed so you can pick out text from book pictures you’ve already taken."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos are accessed so you can pick out text from book pictures you’ve already taken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "访问相册，以便从你已拍好的书籍照片中提取句子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存取照片圖庫，以便從你已拍好的書籍照片中擷取句子。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに撮影した本の写真から文を抽出するために、写真ライブラリにアクセスします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к фото нужен, чтобы извлекать текст из уже сделанных снимков книг."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se accede a tus fotos para extraer frases de las imágenes de libros que ya hayas hecho."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf deine Fotos dient dazu, Sätze aus bereits aufgenommenen Buchfotos zu übernehmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à vos photos sert à extraire des phrases depuis les photos de livres que vous avez déjà prises."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
