    "NSCameraUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "책 표지와 페이지를 촬영해 문장을 추출하기 위해 카메라를 사용합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to photograph book covers and pages so the text can be picked out."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to photograph book covers and pages so the text can be picked out."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用相机拍摄书籍封面和书页，以便提取其中的句子。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 찍어둔 책 사진에서 문장을 추출하기 위해 사진 보관함에 접근합니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos are accessed so you can pick out text from book pictures you’ve already taken."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos are accessed so you can pick out text from book pictures you’ve already taken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "访问相册，以便从你已拍好的书籍照片中提取句子。"
          }
        }
      }
    }
  },
  "version" : "1.0"
