    "정해 둔 때에 모은 문장 하나를 알림으로 보내 줘요." : {
      "comment" : "Roadmap item detail: notifications",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get one of your saved quotes as a notification at the time you choose."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정해 둔 때에 모은 문장 하나를 알림으로 보내 줘요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get one of your saved quotes as a notification at the time you choose."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你设定的时间，以通知推送一条收藏的句子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
