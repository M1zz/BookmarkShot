    "움직임 줄이기를 켜면 화면 효과가 차분해져요." : {
      "comment" : "Roadmap item detail: a11y.motion",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, screen effects calm down."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
