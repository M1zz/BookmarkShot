    "표지 대신(또는 표지와 함께) 뒤표지 바코드를 찍으면 ISBN까지 자동 인식돼요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표지 대신(또는 표지와 함께) 뒤표지 바코드를 찍으면 ISBN까지 자동 인식돼요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photograph the back-cover barcode too (or instead) and the ISBN is picked up automatically."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photograph the back-cover barcode too (or instead) and the ISBN is picked up automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再拍一下封底条形码（或只拍条形码），ISBN 也会自动识别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再拍一下封底條碼（或只拍條碼），ISBN 也會自動辨識。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表紙のかわりに（または表紙といっしょに）裏表紙のバーコードを撮影すると、ISBNも自動で認識されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сфотографируйте штрихкод на задней обложке (вместо обложки или вместе с ней) — ISBN определится автоматически."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fotografías el código de barras de la contraportada (en lugar de la portada o junto a ella), el ISBN se reconoce solo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografierst du statt des Covers (oder zusätzlich) den Barcode auf der Rückseite, wird auch die ISBN automatisch erkannt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photographiez aussi (ou à la place) le code-barres de la quatrième de couverture : l’ISBN est reconnu automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografa anche (o solo) il codice a barre della quarta di copertina: l’ISBN viene riconosciuto in automatico."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografe também (ou só) o código de barras da quarta capa, e o ISBN é reconhecido automaticamente."
          }
        }
      },
      "comment" : "cover_isbn"
    },
