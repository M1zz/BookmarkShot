    "Siri에게 말하거나 단축어로 오늘의 문장을 바로 열어요." : {
      "comment" : "Roadmap item detail: shortcuts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open today’s quote right away with Siri or a shortcut."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri에게 말하거나 단축어로 오늘의 문장을 바로 열어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open today’s quote right away with Siri or a shortcut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对 Siri 说一声，或用快捷指令，直接打开今日一句。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對 Siri 說一聲，或用捷徑，直接打開今日一句。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siriに話しかけるか、ショートカットで、今日の一文をすぐに開けます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте цитату дня голосом через Siri или командой."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la cita del día al instante con Siri o con un atajo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne das Zitat des Tages sofort per Siri oder Kurzbefehl."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez la citation du jour d’un mot à Siri ou avec un raccourci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri subito la citazione del giorno con Siri o un comando rapido."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o trecho do dia na hora, falando com a Siri ou com um atalho."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอก Siri หรือใช้คำสั่งลัดเพื่อเปิดประโยคประจำวันได้ทันที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở ngay câu của hôm nay bằng Siri hoặc phím tắt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citát dne otevřete hned hlasem přes Siri nebo zkratkou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn dagens citat med det samme via Siri eller en genvej."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άνοιξε αμέσως το απόσπασμα της ημέρας με τη Siri ή μια συντόμευση."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa päivän lainaus heti Sirillä tai pikakomennolla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka kutipan hari ini langsung lewat Siri atau pintasan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne dagens sitat med en gang via Siri eller en snarvei."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open het citaat van de dag meteen met Siri of een opdracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz cytat dnia od razu, mówiąc do Siri lub używając skrótu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna dagens citat direkt via Siri eller en genväg."
          }
        },
