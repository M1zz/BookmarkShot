    "읽는 만큼 모으고, 모은 문장은 곁에 두세요. 연 구독이나 평생 중에 고르세요." : {
      "comment" : "Paywall subtitle",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽는 만큼 모으고, 모은 문장은 곁에 두세요. 연 구독이나 평생 중에 고르세요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save every line you love and keep them close. Pick yearly or lifetime."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save every line you love and keep them close. Pick yearly or lifetime."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读到哪里就收集到哪里，让收集的句子常伴身边。可选择年度订阅或终身。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讀到哪裡就收集到哪裡，讓收集的句子常伴身邊。可選擇年度訂閱或終身。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読んだぶんだけ集めて、集めた一文をいつもそばに。年額プランか買い切りを選べます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте каждую любимую строку и держите её рядом. Выберите годовую подписку или навсегда."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda cada frase que te encante y tenla siempre cerca. Elige anual o para siempre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammle jede Stelle, die du liebst, und behalte sie bei dir. Wähle jährlich oder dauerhaft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez chaque phrase que vous aimez, toujours à portée de main. Choisissez l’annuel ou à vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva ogni frase che ami e tienila sempre vicina. Scegli annuale o a vita."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde cada trecho que você ama e mantenha-o por perto. Escolha anual ou vitalício."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บทุกประโยคที่ชอบไว้ใกล้ตัว เลือกได้ทั้งรายปีหรือตลอดชีพ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu mọi câu bạn yêu thích và giữ chúng bên mình. Chọn gói năm hoặc trọn đời."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukládejte každou větu, kterou máte rádi, a mějte ji po ruce. Vyberte roční nebo doživotní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem hver sætning, du holder af, og hav dem tæt på. Vælg årligt eller livstid."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε κάθε φράση που αγαπάτε, πάντα κοντά σας. Επιλέξτε ετήσια ή εφ’ όρου ζωής."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna jokainen rakas kohta ja pidä ne lähellä. Valitse vuosi tai elinikäinen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan setiap kalimat yang Anda suka dan simpan selalu di dekat Anda. Pilih tahunan atau seumur hidup."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
