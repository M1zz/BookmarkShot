    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: a11y.largetext",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大字体后，界面会自动重新排布，不会被截断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大字體後，畫面會自動重新排列，不會被截斷。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字を大きくしても、切れずに見やすく配置し直されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При увеличении шрифта содержимое перестраивается и не обрезается."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al aumentar el tamaño del texto, el contenido se reorganiza sin cortarse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei größerer Schrift wird der Inhalt neu angeordnet, statt abgeschnitten zu werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous agrandissez le texte, l’affichage se réorganise au lieu d’être coupé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ingrandisci il testo, i contenuti si riorganizzano invece di essere tagliati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao aumentar o tamanho do texto, o conteúdo se reorganiza em vez de ser cortado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อขยายขนาดตัวอักษร เนื้อหาจะจัดเรียงใหม่อย่างเหมาะสม ไม่ถูกตัดขาด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tăng cỡ chữ, nội dung được sắp xếp lại gọn gàng thay vì bị cắt mất."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když zvětšíte písmo, obsah se přeskupí a nic se neořízne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du gør teksten større, ordnes indholdet pænt i stedet for at blive skåret af."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν μεγαλώνεις το κείμενο, το περιεχόμενο αναδιατάσσεται αντί να κόβεται."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun suurennat tekstiä, sisältö järjestyy uudelleen eikä leikkaudu pois."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat teks diperbesar, tata letak menyesuaikan dan tidak terpotong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du gjør teksten større, ordnes innholdet pent i stedet for å bli kuttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de tekst vergroot, wordt de inhoud netjes herschikt in plaats van afgesneden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy powiększysz tekst, zawartość układa się na nowo zamiast się ucinać."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du förstorar texten ordnas innehållet om i stället för att klippas av."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazıyı büyüttüğünde içerik kesilmek yerine düzgünce yeniden yerleşir."
          }
        }
      }
    },
