      "comment" : "Roadmap item detail: notifications",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get one of your saved quotes as a notification at the time you choose."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정해 둔 때에 모은 문장 하나를 알림으로 보내 줘요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
