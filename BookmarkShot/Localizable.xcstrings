          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านเนื้อหาได้ง่าย แม้เปิดเพิ่มคอนทราสต์ หรือแยกสีได้ยาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung vẫn dễ đọc, kể cả khi bật tăng độ tương phản hoặc khó phân biệt màu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše zůstane dobře čitelné, i se zvýšeným kontrastem nebo když se špatně rozlišují barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er stadig let at læse, også med øget kontrast eller hvis det er svært at skelne farver."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα διαβάζονται εύκολα, ακόμη και με αυξημένη αντίθεση ή όταν δυσκολεύεσαι να ξεχωρίσεις χρώματα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
