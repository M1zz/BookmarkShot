        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trang sách sẽ được làm phẳng giúp bạn. Sau đó, lướt ngón tay qua các câu muốn chọn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
