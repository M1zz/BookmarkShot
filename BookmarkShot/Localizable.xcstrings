        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิด “ลดการเคลื่อนไหว” เอฟเฟกต์บนหน้าจอจะนุ่มนวลขึ้น"
          }
        },
        "vi" : {
