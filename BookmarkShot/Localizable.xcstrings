    "움직임 줄이기를 켜면 화면 효과가 차분해져요." : {
      "comment" : "Roadmap item detail: a11y.motion",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, screen effects calm down."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "움직임 줄이기를 켜면 화면 효과가 차분해져요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Reduce Motion on, screen effects calm down."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“减弱动态效果”后，界面动画会更平缓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「減少動態效果」後，畫面動畫會更平緩。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視差効果を減らす」をオンにすると、画面の動きがおだやかになります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включено «Уменьшение движения», эффекты на экране становятся спокойнее."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Reducir movimiento activado, los efectos de pantalla son más sutiles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Bewegung reduzieren“ werden die Effekte auf dem Bildschirm ruhiger."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec « Réduire les animations », les effets à l’écran se font plus discrets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Riduci movimento attivo, gli effetti sullo schermo diventano più discreti."
