    "책 페이지를 찍어 밑줄 칠 문장을 고릅니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyfoťte stránku knihy a vyberte řádky k podtržení."
          }
        },
        "da" : {
