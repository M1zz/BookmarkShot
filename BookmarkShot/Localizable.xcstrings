    "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: a11y.contrast",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays easy to read, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays easy to read, even with Increase Contrast on or if colours are hard to tell apart."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“增强对比度”，或不易分辨颜色时，内容依然清晰易读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「提高對比」，或不易分辨顏色時，內容依然清楚易讀。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたり、色の区別がつきにくくても、内容を読み取れます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё легко читается, даже если включена повышенная контрастность или трудно различать цвета."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se lee bien, aunque actives Aumentar contraste o te cueste distinguir los colores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt gut lesbar – auch mit erhöhtem Kontrast oder bei Schwierigkeiten, Farben zu unterscheiden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste lisible, même avec Contraste renforcé ou si les couleurs sont difficiles à distinguer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta leggibile, anche con Aumenta contrasto o se fai fatica a distinguere i colori."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo continua fácil de ler, mesmo com Aumentar Contraste ou se for difícil distinguir cores."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านเนื้อหาได้ง่าย แม้เปิดเพิ่มคอนทราสต์ หรือแยกสีได้ยาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung vẫn dễ đọc, kể cả khi bật tăng độ tương phản hoặc khó phân biệt màu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše zůstane dobře čitelné, i se zvýšeným kontrastem nebo když se špatně rozlišují barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er stadig let at læse, også med øget kontrast eller hvis det er svært at skelne farver."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα διαβάζονται εύκολα, ακόμη και με αυξημένη αντίθεση ή όταν δυσκολεύεσαι να ξεχωρίσεις χρώματα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki pysyy helposti luettavana, vaikka suurempi kontrasti olisi päällä tai värien erottaminen olisi vaikeaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya tetap mudah dibaca, bahkan dengan Tingkatkan Kontras atau jika sulit membedakan warna."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er fortsatt lett å lese, også med økt kontrast eller hvis det er vanskelig å skille farger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles blijft goed leesbaar, ook met meer contrast of als kleuren moeilijk te onderscheiden zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko pozostaje czytelne, także przy większym kontraście lub gdy trudno odróżniać kolory."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt är fortfarande lätt att läsa, även med ökad kontrast eller om det är svårt att skilja färger åt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrast artırılmış olsa da renkleri ayırt etmek zor olsa da her şey kolay okunur kalır."
          }
        }
      }
    },
