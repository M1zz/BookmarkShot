    "Face ID나 Touch ID로 앱을 잠가 모은 문장을 지켜요." : {
      "comment" : "Roadmap item detail: lock.faceid",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your quotes private."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID나 Touch ID로 앱을 잠가 모은 문장을 지켜요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your quotes private."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用面容 ID 或触控 ID 锁住 App，守护你收藏的句子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Face ID 或 Touch ID 鎖住 App，守護你收藏的句子。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face IDまたはTouch IDでアプリをロックして、集めた文を守ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закройте приложение с помощью Face ID или Touch ID, чтобы сохранить цитаты в тайне."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea la app con Face ID o Touch ID para proteger tus citas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperre die App mit Face ID oder Touch ID, damit deine Zitate privat bleiben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillez l’app avec Face ID ou Touch ID pour protéger vos citations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca l’app con Face ID o Touch ID per proteggere le tue citazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueie o app com Face ID ou Touch ID para proteger seus trechos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ล็อกแอปด้วย Face ID หรือ Touch ID เพื่อปกป้องประโยคที่คุณเก็บไว้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa ứng dụng bằng Face ID hoặc Touch ID để bảo vệ những câu bạn đã lưu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamkněte aplikaci přes Face ID nebo Touch ID a ochraňte své citáty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID, så dine citater er beskyttet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλείδωσε την εφαρμογή με Face ID ή Touch ID για να προστατεύεις τα αποσπάσματά σου."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukitse sovellus Face ID:llä tai Touch ID:llä ja suojaa lainauksesi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci aplikasi dengan Face ID atau Touch ID untuk melindungi kutipanmu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID, så sitatene dine er beskyttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrendel de app met Face ID of Touch ID om je citaten te beschermen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokuj aplikację za pomocą Face ID lub Touch ID, aby chronić swoje cytaty."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID så att dina citat skyddas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alıntılarını korumak için uygulamayı Face ID veya Touch ID ile kilitle."
          }
        }
      }
    },
