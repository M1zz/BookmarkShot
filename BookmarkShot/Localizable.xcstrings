          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決めた時間に、保存した文をひとつ通知でお届けします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В выбранное время будем присылать уведомление с одной из ваших цитат."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe una de tus citas guardadas como notificación a la hora que elijas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte zur gewünschten Uhrzeit eines deiner gesicherten Zitate als Mitteilung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez l’une de vos citations en notification à l’heure de votre choix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi una delle tue citazioni salvate come notifica all’ora che scegli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba um dos seus trechos salvos como notificação no horário que escolher."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับประโยคที่เก็บไว้หนึ่งประโยคเป็นการแจ้งเตือนตามเวลาที่คุณตั้ง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận một câu đã lưu qua thông báo vào giờ bạn chọn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nastavenou dobu vám pošleme jeden z uložených citátů jako oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få ét af dine gemte citater som notifikation på det tidspunkt, du vælger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λάβε ένα από τα αποθηκευμένα αποσπάσματά σου ως ειδοποίηση τη στιγμή που θα ορίσεις."
