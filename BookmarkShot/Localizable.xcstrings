        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar elke zin die je mooi vindt en houd ze dichtbij. Kies jaarlijks of levenslang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
